datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum AccountType {
  INDIVIDUAL
  SHARED
}

enum Role {
  OWNER
  MEMBER
}

enum TransactionType {
  INGRESO
  GASTO
  PRESTAMO
}

enum FinancialAccountType {
  EFECTIVO
  BANCO
  TARJETA
}

enum LoanType {
  OTORGADO // Te deben
  RECIBIDO // Debes
}

model User {
  id           String        @id @default(uuid())
  name         String
  email        String        @unique
  password     String? // Opcional para logins vía Google OAuth
  googleId     String?       @unique
  accounts     AccountUser[]
  transactions Transaction[]
  loans        Loan[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Account {
  id                String             @id @default(uuid())
  name              String
  type              AccountType        @default(INDIVIDUAL)
  users             AccountUser[]
  transactions      Transaction[]
  financialAccounts FinancialAccount[]
  budgets           Budget[]
  loans             Loan[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
}

model FinancialAccount {
  id                 String               @id @default(uuid())
  name               String
  type               FinancialAccountType @default(EFECTIVO)
  householdAccountId String
  householdAccount   Account              @relation(fields: [householdAccountId], references: [id], onDelete: Cascade)
  transactions       Transaction[]
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  @@unique([householdAccountId, name])
}

model AccountUser {
  id        String  @id @default(uuid())
  userId    String
  accountId String
  role      Role    @default(OWNER)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([userId, accountId])
}

model Category {
  id           String          @id @default(uuid())
  name         String
  icon         String          @default("🏷️")
  type         TransactionType
  transactions Transaction[]
  budgets      Budget[]
}

model Transaction {
  id                 String           @id @default(uuid())
  amount             Float
  type               TransactionType
  description        String?
  date               DateTime         @default(now())
  accountId          String
  financialAccountId String
  userId             String
  categoryId         String
  account            Account          @relation(fields: [accountId], references: [id], onDelete: Cascade)
  financialAccount   FinancialAccount @relation(fields: [financialAccountId], references: [id], onDelete: Restrict)
  user               User             @relation(fields: [userId], references: [id])
  category           Category         @relation(fields: [categoryId], references: [id])
  createdAt          DateTime         @default(now())
}

model Budget {
  id          String   @id @default(uuid())
  limitAmount Float
  period      String // "MENSUAL", "QUINCENAL"
  accountId   String
  categoryId  String
  account     Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  category    Category @relation(fields: [categoryId], references: [id])
}

model Loan {
  id           String            @id @default(uuid())
  contactName  String
  totalAmount  Float
  dueAmount    Float
  type         LoanType
  loanDate     DateTime          @default(now())
  dueDate      DateTime?
  accountId    String
  userId       String
  account      Account           @relation(fields: [accountId], references: [id], onDelete: Cascade)
  user         User              @relation(fields: [userId], references: [id])
  payments     LoanPayment[]
  installments LoanInstallment[]
  createdAt    DateTime          @default(now())
}

model LoanPayment {
  id        String   @id @default(uuid())
  amount    Float
  date      DateTime @default(now())
  loanId    String
  loan      Loan     @relation(fields: [loanId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([loanId, date])
}

model LoanInstallment {
  id         String   @id @default(uuid())
  amount     Float
  paidAmount Float    @default(0)
  dueDate    DateTime
  loanId     String
  loan       Loan     @relation(fields: [loanId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@index([loanId, dueDate])
}
