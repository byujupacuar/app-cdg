datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum AccountType {
  INDIVIDUAL
  SHARED
}

enum Role {
  OWNER
  MEMBER
}

enum TransactionType {
  INGRESO
  GASTO
  PRESTAMO
}

enum LoanType {
  OTORGADO // Te deben
  RECIBIDO // Debes
}

model User {
  id           String        @id @default(uuid())
  name         String
  email        String        @unique
  password     String? // Opcional para logins vía Google OAuth
  googleId     String?       @unique
  accounts     AccountUser[]
  categories   Category[]
  transactions Transaction[]
  loans        Loan[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Account {
  id                        String                     @id @default(uuid())
  name                      String
  type                      AccountType                @default(INDIVIDUAL)
  users                     AccountUser[]
  transactions              Transaction[]
  financialAccounts         FinancialAccount[]
  financialAccountTransfers FinancialAccountTransfer[]
  budgets                   Budget[]
  loans                     Loan[]
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
}

model FinancialAccount {
  id                       String                     @id @default(uuid())
  name                     String
  type                     String                     @default("EFECTIVO")
  initialBalance           Float                      @default(0)
  householdAccountId       String
  householdAccount         Account                    @relation(fields: [householdAccountId], references: [id], onDelete: Cascade)
  transactions             Transaction[]
  outgoingTransfers        FinancialAccountTransfer[] @relation("TransferFrom")
  incomingTransfers        FinancialAccountTransfer[] @relation("TransferTo")
  linkedFinancialAccountId String?
  linkedFinancialAccount   FinancialAccount?          @relation("LinkedDebitCard", fields: [linkedFinancialAccountId], references: [id], onDelete: Restrict)
  linkedDebitCards         FinancialAccount[]         @relation("LinkedDebitCard")
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime                   @updatedAt

  @@unique([householdAccountId, name])
  @@index([linkedFinancialAccountId])
}

model FinancialAccountTransfer {
  id                     String           @id @default(uuid())
  amount                 Float
  description            String?
  date                   DateTime         @default(now())
  householdAccountId     String
  fromFinancialAccountId String
  toFinancialAccountId   String
  householdAccount       Account          @relation(fields: [householdAccountId], references: [id], onDelete: Cascade)
  fromFinancialAccount   FinancialAccount @relation("TransferFrom", fields: [fromFinancialAccountId], references: [id], onDelete: Restrict)
  toFinancialAccount     FinancialAccount @relation("TransferTo", fields: [toFinancialAccountId], references: [id], onDelete: Restrict)
  createdAt              DateTime         @default(now())

  @@index([householdAccountId, date])
  @@index([fromFinancialAccountId])
  @@index([toFinancialAccountId])
}

model AccountUser {
  id        String  @id @default(uuid())
  userId    String
  accountId String
  role      Role    @default(OWNER)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([userId, accountId])
}

model Category {
  id           String          @id @default(uuid())
  name         String
  icon         String          @default("🏷️")
  type         TransactionType
  userId       String?
  user         User?           @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  budgets      Budget[]

  @@index([userId, name, type])
}

model Transaction {
  id                 String            @id @default(uuid())
  amount             Float
  type               TransactionType
  description        String?
  date               DateTime          @default(now())
  accountId          String
  financialAccountId String?
  userId             String
  categoryId         String
  loanId             String?
  loanPaymentId      String?           @unique
  account            Account           @relation(fields: [accountId], references: [id], onDelete: Cascade)
  financialAccount   FinancialAccount? @relation(fields: [financialAccountId], references: [id], onDelete: Restrict)
  user               User              @relation(fields: [userId], references: [id])
  category           Category          @relation(fields: [categoryId], references: [id])
  loan               Loan?             @relation(fields: [loanId], references: [id], onDelete: Cascade)
  loanPayment        LoanPayment?      @relation(fields: [loanPaymentId], references: [id], onDelete: Cascade)
  createdAt          DateTime          @default(now())
}

model Budget {
  id          String   @id @default(uuid())
  limitAmount Float
  period      String // "MENSUAL", "QUINCENAL"
  accountId   String
  categoryId  String
  account     Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  category    Category @relation(fields: [categoryId], references: [id])
}

model Loan {
  id           String            @id @default(uuid())
  contactName  String
  totalAmount  Float
  dueAmount    Float
  type         LoanType
  loanDate     DateTime          @default(now())
  dueDate      DateTime?
  accountId    String
  userId       String
  account      Account           @relation(fields: [accountId], references: [id], onDelete: Cascade)
  user         User              @relation(fields: [userId], references: [id])
  transactions Transaction[]
  payments     LoanPayment[]
  installments LoanInstallment[]
  createdAt    DateTime          @default(now())
}

model LoanPayment {
  id        String   @id @default(uuid())
  amount    Float
  date      DateTime @default(now())
  loanId    String
  loan      Loan     @relation(fields: [loanId], references: [id], onDelete: Cascade)
  transaction Transaction?
  createdAt DateTime @default(now())

  @@index([loanId, date])
}

model LoanInstallment {
  id         String   @id @default(uuid())
  amount     Float
  paidAmount Float    @default(0)
  dueDate    DateTime
  loanId     String
  loan       Loan     @relation(fields: [loanId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@index([loanId, dueDate])
}
